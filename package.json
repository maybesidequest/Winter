{
  "name": "interchat-web",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "bun run server.ts",
    "smoke:docker": "bash scripts/docker-smoke.sh",
    "validate:phase2": "bun run scripts/validate-phase2-matrix.ts",
    "typecheck": "react-router typegen && tsc",
    "generate:control-types": "mkdir -p app/generated/control/v1/google/protobuf app/generated/control/v1/interchat/control/v1 && proto-loader-gen-types --keepCase=false --longs=Number --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js -I ../interchat-protobuf -O app/generated/control/v1 ../interchat-protobuf/control/v1/models.proto ../interchat-protobuf/control/v1/hub_service.proto ../interchat-protobuf/control/v1/server_service.proto ../interchat-protobuf/control/v1/connection_service.proto ../interchat-protobuf/control/v1/user_service.proto ../interchat-protobuf/control/v1/moderation_service.proto"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@orpc/client": "^1.15.0",
    "@orpc/react-query": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/jsonwebtoken": "^9.0.10",
    "antd": "^6.6.1",
    "cytoscape": "^3.34.1",
    "dayjs": "^1.11.23",
    "highcharts": "^13.0.1",
    "highcharts-react-official": "^3.2.3",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.1",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "pg": "^8.23.0",
    "phoenix": "^1.8.12",
    "rc-select": "^14.16.8",
    "react": "^19.2.8",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-virtuoso": "^4.18.12",
    "remix-auth": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.2.18",
    "@types/react-cytoscapejs": "^1.2.6",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
